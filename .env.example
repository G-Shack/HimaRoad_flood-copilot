# Copy to .env (never commit it) and run: chmod 600 .env
# Satellite access for new runs (Copernicus Data Space Ecosystem, Sentinel Hub OAuth client):
SH_CLIENT_ID=
SH_CLIENT_SECRET=
# Pre-event OpenStreetMap through the ohsome API v2:
OHSOME_API_KEY=
# Data folders (absolute paths):
HIMAROAD_DATA_DIR=/absolute/path/HimaRoad_flood-copilot/data
DATA_ROOT=/absolute/path/HimaRoad_flood-copilot/data/copilot
COLLAB_AGENT=codex
REPORT_FONT=/absolute/path/HimaRoad_flood-copilot/data/copilot/cache/fonts/NotoSansDevanagari.ttf
